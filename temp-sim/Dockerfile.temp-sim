# Pinned by digest (not just the "3.12-slim" tag) for byte-identical rebuilds
FROM python:3.12-slim@sha256:78387bc3881b8273120a12ebe6c1ab22b018ccc2c9adf565ae1ac9b536e184ea

# Dedicated non-root user, no login shell/password needed
RUN useradd -m temp-sim

# Drop root for everything from here on
USER temp-sim
# All relative paths below (sim_tmp108.py) resolve against this
WORKDIR /workspace

# Standard OCI annotation keys (docker inspect/registries read these).
# BUILD_DATE comes from docker-compose.yml's build.args, set by run.ps1.
# Placed at the end so it doesn't invalidate the cache for the layers above.
ARG BUILD_DATE="unknown"
LABEL org.opencontainers.image.authors="schoenenberger <rafael@schoenenberger.dev>" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.description="TMP108 temperature sensor simulator image. Used by the temp-sim service in compose/docker-compose.yml."

# Runs as the container's main process (PID 1) - no supervisor/entrypoint wrapper
CMD ["python3", "sim_tmp108.py"]
