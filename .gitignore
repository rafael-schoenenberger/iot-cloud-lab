# firmware build artifacts (cmake/ninja output, generated on every build)
firmware/build/*
firmware/build_unit_tests/*

# Python bytecode cache (temp-sim/, modem-sim/)
__pycache__/
*.pyc

# generated from Terraform outputs by infra/terraform/iot/certs/ -> firmware header script
firmware/src/aws_certs.h

# Terraform state (kept local, not in a remote backend - see infra/terraform/iot/main.tf)
# and local provider cache
infra/terraform/**/.terraform/
infra/terraform/**/.terraform.lock.hcl
infra/terraform/**/*.tfstate
infra/terraform/**/*.tfstate.*
infra/terraform/**/crash.log
infra/terraform/**/*.tfvars
infra/terraform/**/*.tfvars.json

# AWS IoT device certificates and private keys generated by terraform apply
infra/terraform/**/certs/

