# Build: download and extract renode
# Pinned by digest (not just the "22.04" tag) for byte-identical rebuilds
FROM ubuntu:22.04@sha256:829f6df217bcbae2b371026e81711d1a787c61b2967ad09d015063663ebafbf7 AS builder

ARG RENODE_VERSION=1.16.1

# Install tools required for downloading and unpacking renode. Version
# pinned to the exact candidate resolved on this base image - bump
# deliberately, don't let it silently drift on a later rebuild.
RUN apt-get update && apt-get install -y wget=1.21.2-2ubuntu1.5 \
    && rm -rf /var/lib/apt/lists/*

# Download+extract renode (self-contained, bundles the .NET runtime). SHA256
# confirmed against GitHub's own release-asset digest before pinning it -
# tied to RENODE_VERSION=1.16.1, update together if that ARG is bumped.
RUN mkdir -p /opt/renode \
    && wget -q https://github.com/renode/renode/releases/download/v${RENODE_VERSION}/renode-${RENODE_VERSION}.linux-portable-dotnet.tar.gz \
    && echo "00e113cdbd0f5354cf2f64bbe3f5a070d8958409542fca66e45ac97d982938c0  renode-${RENODE_VERSION}.linux-portable-dotnet.tar.gz" > renode.sha256 \
    && sha256sum -c renode.sha256 \
    && rm renode.sha256 \
    && tar xzf renode-${RENODE_VERSION}.linux-portable-dotnet.tar.gz -C /opt/renode --strip-components=1 \
    && rm renode-${RENODE_VERSION}.linux-portable-dotnet.tar.gz

# Runtime: full-feature renode environment
# Pinned by digest (not just the "22.04" tag) for byte-identical rebuilds
FROM ubuntu:22.04@sha256:829f6df217bcbae2b371026e81711d1a787c61b2967ad09d015063663ebafbf7

# python3/pip: renode's Robot testing framework. libicu: the .NET runtime
# needs it for globalization, despite being otherwise self-contained.
# Versions pinned to the exact candidates resolved on this base image -
# bump deliberately, don't drift.
RUN apt-get update && apt-get install -y \
    python3=3.10.6-1~22.04.1 \
    python3-pip=22.0.2+dfsg-1ubuntu0.7 \
    libicu70=70.1-2 \
    && rm -rf /var/lib/apt/lists/*

# Copy renode from builder stage
COPY --from=builder /opt/renode /opt/renode

# Add renode to PATH
ENV PATH="/opt/renode:${PATH}"

# Dedicated non-root user, no login shell/password needed
RUN useradd -m renode

# Drop root for everything from here on
USER renode
WORKDIR /workspace

# Standard OCI annotation keys - only on this final stage, not the discarded
# "builder" stage. BUILD_DATE comes from docker-compose.yml's build.args.
# Placed at the end so it doesn't invalidate the cache for the layers above.
ARG BUILD_DATE="unknown"
LABEL org.opencontainers.image.authors="schoenenberger <rafael@schoenenberger.dev>" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.description="STM32F407 simulator (Renode) image. Used by the renode service in compose/docker-compose.yml."

# Start renode by default
CMD ["renode"]
