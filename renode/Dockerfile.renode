# Build: download and extract renode
FROM ubuntu:22.04 AS builder

ARG RENODE_VERSION=1.16.1

# Install tools required for downloading and unpacking renode
RUN apt-get update && apt-get install -y wget \
    && rm -rf /var/lib/apt/lists/*

# Download and extract renode portable package (self-contained, bundles the .NET runtime)
RUN mkdir -p /opt/renode \
    && wget https://github.com/renode/renode/releases/download/v${RENODE_VERSION}/renode-${RENODE_VERSION}.linux-portable-dotnet.tar.gz \
    && tar xzf renode-${RENODE_VERSION}.linux-portable-dotnet.tar.gz -C /opt/renode --strip-components=1 \
    && rm renode-${RENODE_VERSION}.linux-portable-dotnet.tar.gz

# Runtime: full-feature renode environment
FROM ubuntu:22.04

# Install python dependencies + libicu (the .NET runtime needs it for globalization,
# even though the portable-dotnet package is otherwise self-contained)
RUN apt-get update && apt-get install -y \
    python3 python3-pip libicu70 \
    && rm -rf /var/lib/apt/lists/*

# Copy renode from builder stage
COPY --from=builder /opt/renode /opt/renode

# Add renode to PATH
ENV PATH="/opt/renode:${PATH}"

# Create non-root user
RUN useradd -m renode
USER renode

# Set working directory
WORKDIR /workspace

# Start renode by default
CMD ["renode"]
