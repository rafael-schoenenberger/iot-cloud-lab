# CPU: ARM Cortex‑M4 Core
cpu: CPU.CortexM @ sysbus
    cpuType: "cortex-m4"

# Flash: On‑Chip Program Memory
flash: Memory.MappedMemory @ sysbus 0x08000000
    size: 0x100000	# 1 MB

# SRAM: On‑Chip Data Memory
sram: Memory.MappedMemory @ sysbus 0x20000000
    size: 0x20000	# 128 KB

# NVIC: Nested Vectored Interrupt Controller
nvic: Miscellaneous.NVIC @ sysbus 0xE000E100

# SCB: System Control Block
scb: Miscellaneous.SCB @ sysbus 0xE000ED00

# SysTick: System Timer
systick: Miscellaneous.SysTick @ sysbus 0xE000E010

# EXTI: External Interrupt Controller
exti: Miscellaneous.STM32_EXTI @ sysbus 0x40013C00

# RCC: Reset and Clock Control
rcc: Miscellaneous.STM32_RCC @ sysbus 0x40023800

# PWR: Power Control
pwr: Miscellaneous.STM32_PWR @ sysbus 0x40007000

# UART1: GPS
uart1: UART.STM32_UART @ sysbus 0x40011000
    irq: 37
    baudRate: 115200

# UART2: Debug output (directed to VS Code)
uart2: UART.STM32_UART @ sysbus 0x40004400
    irq: 38
    baudRate: 115200

# I2C1: Temperature sensor
i2c1: I2C.STM32_I2C @ sysbus 0x40005400
    irq: 31

# SPI1: Pressure sensor
spi1: SPI.STM32_SPI @ sysbus 0x40013000
    irq: 35

# GPIO ports
gpioa: GPIOPort.STM32_GPIO @ sysbus 0x40020000
gpiob: GPIOPort.STM32_GPIO @ sysbus 0x40020400
